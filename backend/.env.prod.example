# Variables de production pour compose.prod.yaml : copier en .env.prod (jamais versionné), remplir, puis
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
# Générer les secrets avec : openssl rand -hex 32

# Secret Symfony propre à ce serveur (le démarrage refuse la valeur par défaut)
APP_SECRET=
# Base PostgreSQL (créée au premier démarrage, migrations appliquées à chaque démarrage)
POSTGRES_PASSWORD=
POSTGRES_DB=unifolio
POSTGRES_USER=app
# Origine du front, en expression régulière (le front relaie /api/** : seul lui appelle l'API)
CORS_ALLOW_ORIGIN='^https://portfolio\.exemple\.fr$'
# IP exacte du reverse proxy ou du serveur Nuxt qui relaie /api/** (limite de connexion par visiteur)
TRUSTED_PROXIES=
# Clé de l'API de l'intranet (synchronisation)
API_KEY=
MAILER_DSN=null://null
# Port publié de l'API sur l'hôte
API_PORT=8000
