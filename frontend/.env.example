# Copier en `.env` pour surcharger la configuration en local.

# Origine de l'API (sans /api à la fin).
# Vide = routes Nitro locales avec données factices (phase 1).
# Exemple pour ApiPlatform : NUXT_PUBLIC_API_BASE=https://localhost
NUXT_PUBLIC_API_BASE=

# Bascule vers ApiPlatform (Sprint 4, recommandé) : relaie /api/** vers l'API, sur la même origine que le front.
# Laisser NUXT_PUBLIC_API_BASE vide dans ce cas. Vide = routes Nitro factices.
# NUXT_API_PROXY=http://localhost:8000
NUXT_API_PROXY=
